# Copy this file to .env and fill in real values. .env is gitignored.

# --- SEC EDGAR ---
# SEC requires every automated request to declare who is making it, in the
# form "<Company/App Name> <contact email>". Requests without this header
# are rejected with a 403 "Undeclared Automated Tool" error, and SEC asks
# that you keep it accurate so they can reach you if your script misbehaves.
SEC_USER_AGENT="AlphaTrace research-bot your-email@example.com"

# --- Postgres (must match docker-compose.yml) ---
POSTGRES_USER=alphatrace
POSTGRES_PASSWORD=change-me
POSTGRES_DB=alphatrace
POSTGRES_PORT=5432
DATABASE_URL=postgresql://alphatrace:change-me@localhost:5432/alphatrace

# --- FastAPI ---
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# --- LLM (Groq) ---
# The Research Analyst Agent's grounded-answer call. Get a key at
# console.groq.com -- required before app.llm.generate() (or the Analyst
# Agent) can run; everything else in the repo works without it.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
